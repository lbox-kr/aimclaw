# NanoClaw 팀 봇 환경변수 — mini의 .env 작성 시 참고 (TEAM.md의 설치 절차 참고)
# 이 파일은 키 목록 문서다. 값은 .env에만 넣고, .env는 절대 커밋하지 않는다.

# Slack Bot User OAuth Token (xoxb-...). api.slack.com/apps → OAuth & Permissions.
# 필요 스코프는 .claude/skills/add-slack/SKILL.md 참고.
SLACK_BOT_TOKEN=

# Slack App-Level Token (xapp-..., connections:write 스코프).
# 이 값이 있으면 Socket Mode로 동작 — 공개 웹훅 URL 불필요. 팀 표준.
SLACK_APP_TOKEN=

# Slack Signing Secret. 웹훅(HTTP) 모드일 때만 필요 — Socket Mode에선 비워둔다.
SLACK_SIGNING_SECRET=

# 봇 호출 이름 (슬랙에서 봇을 부르는 이름)
ASSISTANT_NAME=

# 컨테이너 이미지에 CJK 폰트 포함 — 한국어 렌더링(스크린샷·PDF 등)에 필요.
# 이미지 크기 +200MB.
INSTALL_CJK_FONTS=true

# 타임존
TZ=Asia/Seoul
